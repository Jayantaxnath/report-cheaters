{
  "manifest_version": 3,
  "name": "Report Helper",
  "version": "1.0.0",
  "description": "Pick a row + question on a LeetCode contest ranking page; it runs the Code Replay > Report Cheating flow.",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "Toggle Report Helper",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/contest/*"
      ],
      "js": [
        "content.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://leetcode.com/contest/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}